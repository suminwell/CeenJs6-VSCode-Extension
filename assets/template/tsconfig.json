{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "typeRoots": [
            "./node_modules/ceenjs6/declarations",
            "./declarations"
        ],
        "types": [
            "ceenjs6"
        ],
        "skipLibCheck": true
    },
    "exclude": [
        "node_modules",
        "out",
        "build",
        "**/cj6-jsox-extensions.d.ts",
        "**/cj6-jsox-*-extensions.d.ts"
    ]
}
