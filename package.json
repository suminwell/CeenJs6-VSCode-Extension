{
    "name": "ceenjs6",
    "displayName": "CeenJs6",
    "description": "使用 VSCode 开发 CeenJs6 安卓自动化脚本和项目",
    "version": "1.0.14",
    "requiredClientVersionName": "6.7.0",
    "requiredClientVersionCode": "3804",
    "publisher": "yeceen",
    "icon": "assets/images/ceenjs6_material.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/suminwell/CeenJs6-VSCode-Extension.git"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "breakpoints": [
            {
                "language": "javascript"
            }
        ],
        "commands": [
            {
                "command": "ceenjs6.viewDocument",
                "title": "查看在线文档 (View Online Document)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.connect",
                "title": "建立设备连接 (Connect)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/link.svg",
                    "dark": "assets/icons-night/link.svg"
                }
            },
            {
                "command": "ceenjs6.disconnectAll",
                "title": "断开所有连接 (Disconnect All)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.run",
                "title": "运行脚本 (Run)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/play-circle.svg",
                    "dark": "assets/icons-night/play-circle.svg"
                }
            },
            {
                "command": "ceenjs6.runWithoutArguments",
                "title": "运行脚本 (Run)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/play-circle.svg",
                    "dark": "assets/icons-night/play-circle.svg"
                }
            },
            {
                "command": "ceenjs6.commandsHierarchy",
                "title": "命令层级 (Commands Hierarchy)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.runOnDevice",
                "title": "指定设备运行 (Run On Device)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.stop",
                "title": "停止当前脚本 (Stop)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/error.svg",
                    "dark": "assets/icons-night/error.svg"
                }
            },
            {
                "command": "ceenjs6.stopAll",
                "title": "停止所有脚本 (Stop All)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/close-all.svg",
                    "dark": "assets/icons-night/close-all.svg"
                }
            },
            {
                "command": "ceenjs6.rerun",
                "title": "重新运行脚本 (Rerun)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.save",
                "title": "保存到所有设备 (Save)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/save.svg",
                    "dark": "assets/icons-night/save.svg"
                }
            },
            {
                "command": "ceenjs6.saveToDevice",
                "title": "保存到指定设备 (Save On Device)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.newUntitledFile",
                "title": "新建文件 (New File)",
                "category": "CeenJs6"
            },
            {
                "command": "ceenjs6.newProject",
                "title": "新建项目 (New Project)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/diff-added.svg",
                    "dark": "assets/icons-night/diff-added.svg"
                }
            },
            {
                "command": "ceenjs6.saveProject",
                "title": "保存项目到设备 (Save Project)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/save-all.svg",
                    "dark": "assets/icons-night/save-all.svg"
                }
            },
            {
                "command": "ceenjs6.saveProjectWithoutArguments",
                "title": "保存项目到设备 (Save Project)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/save-all.svg",
                    "dark": "assets/icons-night/save-all.svg"
                }
            },
            {
                "command": "ceenjs6.runProject",
                "title": "运行项目 (Run Project)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/run-all.svg",
                    "dark": "assets/icons-night/run-all.svg"
                }
            },
            {
                "command": "ceenjs6.runProjectWithoutArguments",
                "title": "运行项目 (Run Project)",
                "category": "CeenJs6",
                "icon": {
                    "light": "assets/icons/run-all.svg",
                    "dark": "assets/icons-night/run-all.svg"
                }
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "ceenjs6.connect",
                    "group": "navigation@60"
                },
                {
                    "command": "ceenjs6.runWithoutArguments",
                    "group": "navigation@63",
                    "when": "resourceLangId == javascript"
                },
                {
                    "command": "ceenjs6.stop",
                    "group": "navigation@66",
                    "when": "resourceLangId == javascript"
                },
                {
                    "command": "ceenjs6.stopAll",
                    "group": "navigation@69"
                },
                {
                    "command": "ceenjs6.save",
                    "group": "navigation@72"
                },
                {
                    "command": "ceenjs6.runProjectWithoutArguments",
                    "group": "navigation@75"
                },
                {
                    "command": "ceenjs6.saveProjectWithoutArguments",
                    "group": "navigation@78"
                },
                {
                    "command": "ceenjs6.newProject",
                    "group": "navigation@81"
                }
            ],
            "explorer/context": [
                {
                    "command": "ceenjs6.run",
                    "group": "navigation@60",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.runOnDevice",
                    "group": "navigation@63",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.stop",
                    "group": "navigation@69",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.stopAll",
                    "group": "navigation@72",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.rerun",
                    "group": "navigation@75",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.saveToDevice",
                    "group": "navigation@78",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.save",
                    "group": "navigation@81",
                    "when": "!explorerResourceIsFolder && resourceExtname == .js"
                },
                {
                    "command": "ceenjs6.runProject",
                    "group": "navigation@84",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "ceenjs6.saveProject",
                    "group": "navigation@87",
                    "when": "explorerResourceIsFolder"
                },
                {
                    "command": "ceenjs6.newProject",
                    "group": "navigation@90",
                    "when": "explorerResourceIsFolder"
                }
            ],
            "commandPalette": [
                {
                    "command": "ceenjs6.runWithoutArguments",
                    "when": "false"
                },
                {
                    "command": "ceenjs6.runProjectWithoutArguments",
                    "when": "false"
                },
                {
                    "command": "ceenjs6.saveProjectWithoutArguments",
                    "when": "false"
                }
            ]
        },
        "keybindings": [
            {
                "command": "ceenjs6.viewDocument",
                "key": "alt+shift+f6",
                "mac": "cmd+shift+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.run",
                "key": "f6",
                "mac": "f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.commandsHierarchy",
                "key": "f8",
                "mac": "f8",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.stopAll",
                "key": "ctrl+shift+f6",
                "mac": "ctrl+shift+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.connect",
                "key": "ctrl+alt+f6",
                "mac": "ctrl+cmd+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.disconnectAll",
                "key": "ctrl+alt+shift+f6",
                "mac": "ctrl+cmd+shift+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.stop",
                "key": "ctrl+f6",
                "mac": "ctrl+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.runProject",
                "key": "alt+f6",
                "mac": "cmd+f6",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.runProject",
                "key": "ctrl+alt+6 r",
                "mac": "ctrl+cmd+6 r",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.newProject",
                "key": "ctrl+alt+6 n",
                "mac": "ctrl+cmd+6 n",
                "when": "editorTextFocus"
            },
            {
                "command": "ceenjs6.saveProject",
                "key": "ctrl+alt+6 s",
                "mac": "ctrl+cmd+6 s",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "CeenJs6",
            "properties": {
                "ceenjs6.enableHttpControl": {
                    "type": "boolean",
                    "default": false,
                    "description": "启用本机 HTTP 命令接口 (127.0.0.1:10347)。更改后请重新加载窗口。"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node --test test/*.test.cjs",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/archiver": "^3.0.0",
        "@types/node": "^18.19.0",
        "@types/stream-buffers": "^3.0.2",
        "@types/vscode": "1.85.0",
        "typescript": "^5.3.3",
        "@vscode/vsce": "^3.6.2"
    },
    "dependencies": {
        "archiver": "^3.0.0",
        "stream-buffers": "^3.0.2",
        "systeminformation": "^5.23.12",
        "pinyin": "^2.11.0"
    },
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/suminwell/CeenJs6-VSCode-Extension#readme",
    "bugs": {
        "url": "https://github.com/suminwell/CeenJs6-VSCode-Extension/issues"
    },
    "keywords": [
        "CeenJs6",
        "ceenjs",
        "android",
        "automation",
        "javascript"
    ]
}
